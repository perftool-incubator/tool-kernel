{
    "rickshaw-tool": {
        "schema": {
            "version": "2020.03.18"
        }
    },
    "tool": "kernel",
    "collector": {
        "files-from-controller": [
            {
                "src": "%tool-dir%/kerneltools-start",
                "dest": "/usr/bin/"
            },
            {
                "src": "%tool-dir%/kerneltools-stop",
                "dest": "/usr/bin/"
            },
            {
                "src": "%tool-dir%/kerneltools-hw-counters.py",
                "dest": "/usr/bin/"
            },
            {
                "src": "%tool-dir%/kerneltools-post-process.py",
                "dest": "/usr/bin/"
            }
        ],
        "blacklist": [
            {
                "endpoint": "remotehosts",
                "collector-types": [
                    "client",
                    "server"
                ]
            },
            {
                "endpoint": "kube",
                "collector-types": [
                    "client",
                    "server"
                ]
            }
        ],
        "whitelist": [
            {
                "endpoint": "osp",
                "collector-types": [
                    "compute"
                ]
            },
            {
                "endpoint": "remotehosts",
                "collector-types": [
                    "profiler"
                ]
            },
            {
                "endpoint": "kube",
                "collector-types": [
                    "profiler"
                ]
            }
        ],
        "start": "kerneltools-start",
        "stop": "kerneltools-stop",
        "param_regex": [ "s/(--[a-zA-Z0-9_-]+)=ON\\b/$1/g",
                          "s/--[a-zA-Z0-9_-]+=OFF\\b\\s*//g"
                        ]
    },
    "controller": {
        "post-script": "%tool-dir%kerneltools-post-process.py"
    }
}
